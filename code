library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity countr is
port (clk : in std_logic;
      reset : in std_logic;
      enable : in std_logic;
      m : in std_logic;   --selector for up down counter
      y : out std_logic_vector(7 downto 0));
end countr;

architecture countr_arch of countr is 
      signal count_reg : unsigned(7 downto 0) := (others => '0');
      
      begin
      process(clk)
       begin
        if rising_edge(clk) then
         
         if reset='1' then 
          count_reg<=(others=>'0');
          
         elsif enable='1' then 
            if m<='0' then 
             count_reg<= count_reg + 1;
             else
             count_reg<= count_reg - 1;
             end if;
            end if;
           end if;
          end process;
          
          y<= std_logic_vector(count_reg);
          
        end countr_arch;
             
          
          
          
