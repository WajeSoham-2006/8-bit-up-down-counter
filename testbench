library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity countr_tb is

end countr_tb;

architecture countr_tb_arch of countr_tb is

signal clk : std_logic :='0';
signal reset : std_logic :='0';
signal enable : std_logic :='0';
signal m : std_logic :='0';
signal y : std_logic_vector(7 downto 0);

component countr 
port (clk : in std_logic;
      reset : in std_logic;
      enable : in std_logic;
      m : in std_logic;   --selector for up down counter
      y : out std_logic_vector(7 downto 0));
end component;

begin 

uut : countr port map (clk=>clk , reset=>reset , enable=>enable , m=>m , y=>y );

 clk_process: process
    begin
        clk <= '0';
        wait for 5 ns;
        clk <= '1';
        wait for 5 ns;
    end process;

stim_proc : process
    begin
    
   -- reset at start
    reset  <= '1';
    enable <= '0';
    m      <= '0';
    wait for 20 ns;

    -- count up
    reset  <= '0';
    enable <= '1';
    m      <= '0';
    wait for 200 ns;

    -- count down
    m <= '1';
    wait for 100 ns;

    -- pause (output should hold)
    enable <= '0';
    wait for 50 ns;

    -- reset again
    reset <= '1';
    wait for 20 ns;
    reset <= '0';

    wait;
    end process;
    end countr_tb_arch;
     
          
